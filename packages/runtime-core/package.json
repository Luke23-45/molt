{
  "name": "@molt/runtime",
  "version": "0.0.0",
  "description": "A general plugin runtime for safe replacement.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "build": "tsdown",
    "api-extract": "api-extractor run --local"
  },
  "dependencies": {
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@types/semver": "^7.8.0",
    "fast-check": "^4.9.0",
    "tsdown": "^0.22.14"
  }
}
